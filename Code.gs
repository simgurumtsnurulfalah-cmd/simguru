      end = String(end).substring(0, 5);
      const isDone = allLogs.some((log) => {
        const logDate = Utilities.formatDate(
          new Date(log.date + (String(log.date).length === 10 ? "T00:00:00" : "")),
          "Asia/Jakarta",
          "yyyy-MM-dd",
