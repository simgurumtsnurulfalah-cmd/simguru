      console.log(
        "[runAutoJurnalScheduler] " + dateStr + " bukan hari libur. Skip.",
      );
      return { status: "skip", reason: "NOT_HOLIDAY", date: dateStr };
    }
    console.log(
      "[runAutoJurnalScheduler] " +
        dateStr +
        ' adalah hari libur ("' +
        holiday.description +
        '"). Menjalankan auto-jurnal...',
